# Ghostty Base Configuration
# Theme colors come from the fragment included after this file (see config)

# Font
font-family = "Maple Mono NF"
font-size = 11
# font-style = Bold      # was forcing everything bold — part of the "too large" feel
font-thicken = false
adjust-cell-height = 10%

# Window
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.95
window-decoration = false
window-save-state = always

# Behavior
copy-on-select = clipboard
confirm-close-surface = false
mouse-hide-while-typing = true
focus-follows-mouse = false

# Shell integration
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 500000

# Performance
bold-is-bright = false

# Input
clipboard-paste-protection = false
cursor-click-to-move = true






# Cursor animation shader (floaty smear). Swap the file to change the effect:
# cursor_tail / cursor_sweep / ripple_cursor / sonic_boom_cursor / ...
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = always
