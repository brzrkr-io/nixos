# Ghostty Base Configuration
# Theme colors come from the fragment included after this file (see config)

# Font
font-family = "IosevkaTerm Nerd Font Mono"
font-size = 10
# Bold as the base weight; bold text steps up to ExtraBold so it still stands out
font-style = Bold
font-style-bold = ExtraBold
font-thicken = false
adjust-cell-height = 10%

# Window
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
background-opacity = 0.78
window-decoration = false
window-save-state = always

# Splits: dim whatever isn't focused
unfocused-split-opacity = 0.45

# Behavior
copy-on-select = clipboard
confirm-close-surface = false
mouse-hide-while-typing = true
focus-follows-mouse = false

# Shell integration (no-cursor: keep the block cursor at the prompt too)
shell-integration = zsh
shell-integration-features = no-cursor,sudo,title

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback: bytes, not lines — 100MB ≈ 1M lines per surface, allocated
# lazily so the ceiling is free until output actually fills it.
# (Inside tmux this doesn't apply; that's history-limit in tmux.conf.)
scrollback-limit = 100000000

# Performance
bold-is-bright = false

# Input
clipboard-paste-protection = false
cursor-click-to-move = true






# Cursor animation shader (floaty smear). Swap the file to change the effect:
# cursor_tail / cursor_sweep / ripple_cursor / sonic_boom_cursor / ...
# animation=true (not always): render only while the effect is active —
# `always` kept the 4K surface redrawing at full framerate even when idle
custom-shader = shaders/cursor_warp.glsl
custom-shader-animation = true
