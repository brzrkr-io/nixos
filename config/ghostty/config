# Ghostty entry point: base settings + active theme fragment.
# The theme fragment is flipped by the `theme` CLI (~/.config/theme/current);
# `?` makes it optional so ghostty still starts if the symlink is missing.
config-file = config.base
config-file = ?/home/pjanderson/.config/theme/current/ghostty.conf

# Cursor tracks the cell it sits on (after the theme include so it beats the
# theme's hardcoded cursor-color, whatever theme is active)
cursor-color = cell-foreground
cursor-text = cell-background

# Mac-style copy/paste (xremap skips terminals by design)
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
