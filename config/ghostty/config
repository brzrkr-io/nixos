# Ghostty entry point: base settings + active theme fragment.
# The theme fragment is flipped by the `theme` CLI (~/.config/theme/current);
# `?` makes it optional so ghostty still starts if the symlink is missing.
config-file = config.base
config-file = ?/home/pjanderson/.config/theme/current/ghostty.conf
# Optional runtime override; the Hyprland opacity toggle owns this file.
config-file = ?/home/pjanderson/.local/state/ghostty/opacity.conf

# Cursor tracks the cell it sits on (after the theme include so it beats the
# theme's hardcoded cursor-color, whatever theme is active)
cursor-color = cell-foreground
cursor-text = cell-background

# Mac-style application shortcuts (xremap skips terminals by design)
keybind = super+a=select_all
keybind = super+c=copy_to_clipboard
keybind = super+f=start_search
keybind = super+n=new_window
keybind = super+q=quit
keybind = super+t=new_tab
keybind = super+v=paste_from_clipboard
keybind = super+w=close_surface
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size

# Shift+Space: send a plain space. Claude Code 2.1.x mis-decodes the kitty
# keyboard protocol's CSI 32;2u and types the literal word "space"
# (anthropics/claude-code#17003) — intercept before encoding, like a mac would
keybind = shift+space=text:\x20
theme = noctalia
