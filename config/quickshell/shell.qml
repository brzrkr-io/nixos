// Quickshell top bar — themed via Colors.qml, single file.
// Left:  workspaces (persistent 1-5 + occupied), focused window title
// Right: volume, network, tray, clock
// NOTE: launch with QT_SCALE_FACTOR=1 (hyprland.lua does this) — the global
// QT_SCALE_FACTOR=0.9 session hack otherwise overrides the monitor's 2x scale.

import Quickshell
import Quickshell.Io
import Quickshell.Wayland
import Quickshell.Hyprland
import Quickshell.Services.SystemTray
import Quickshell.Services.Mpris
import Quickshell.Services.Notifications
import QtQuick
import QtQuick.Layouts

ShellRoot {
    id: root

    // ── Theme ────────────────────────────────────────────────────────────
    // Colors.qml is generated by the `theme` CLI (overwrite triggers
    // quickshell's file-watch reload); downstream code keeps the col* names
    Colors { id: palette }

    property color colBar: palette.bar        // bar background (darker than windows)
    property color colPill: palette.pill      // module pill background
    property color colPillHover: palette.pillHover
    property color colFg: palette.fg
    property color colDim: palette.dim
    property color colAccent: palette.accent
    property color colPurple: palette.purple
    property color colCyan: palette.cyan
    property color colGreen: palette.green
    property color colRed: palette.red
    property string fontFamily: "Maple Mono NF"
    property int fontSize: 13

    // ── State ────────────────────────────────────────────────────────────
    property string activeWindow: ""
    property int volumeLevel: 0
    property bool volumeMuted: false
    property string netStatus: "offline" // "ethernet" | "wifi" | "offline"
    property var now: new Date()
    property bool clockShowDate: false

    // ── Focused window title (hyprctl, event-driven + slow fallback) ────
    Process {
        id: windowProc
        command: ["sh", "-c", "hyprctl activewindow -j 2>/dev/null | tr -d '\\n'; echo"]
        stdout: SplitParser {
            onRead: data => {
                try {
                    root.activeWindow = JSON.parse(data).title ?? ""
                } catch (e) {
                    root.activeWindow = ""
                }
            }
        }
        Component.onCompleted: running = true
    }

    Connections {
        target: Hyprland
        function onRawEvent(event) {
            windowProc.running = true
        }
    }

    // ── Volume (wpctl polling — tony-btw's proven pattern) ──────────────
    Process {
        id: volProc
        command: ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]
        stdout: SplitParser {
            onRead: data => {
                var match = data.match(/Volume:\s*([\d.]+)/)
                if (match)
                    root.volumeLevel = Math.round(parseFloat(match[1]) * 100)
                root.volumeMuted = data.indexOf("MUTED") !== -1
            }
        }
        Component.onCompleted: running = true
    }

    Process {
        id: volActionProc
    }

    function volAction(args) {
        // restart so rapid actions (scroll steps) aren't dropped on a running process
        volActionProc.running = false
        volActionProc.command = ["wpctl"].concat(args)
        volActionProc.running = true
        volRefresh.restart()
    }

    Timer {
        id: volRefresh
        interval: 150
        onTriggered: volProc.running = true
    }

    // ── Volume OSD (replaces swayosd) ────────────────────────────────────
    // Shown ONLY by the media-key IPC calls below (hyprland.lua binds run
    // `qs ipc call osd ...`) — never by the startup/drift poll.
    property bool osdVisible: false

    function showOsd() {
        osdVisible = true
        osdHide.restart()
    }

    Timer {
        id: osdHide
        interval: 1200
        onTriggered: root.osdVisible = false
    }

    IpcHandler {
        target: "osd"
        function volumeUp(): void {
            root.volAction(["set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "5%+"])
            root.showOsd()
        }
        function volumeDown(): void {
            root.volAction(["set-volume", "@DEFAULT_AUDIO_SINK@", "5%-"])
            root.showOsd()
        }
        function muteToggle(): void {
            root.volAction(["set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
            root.showOsd()
        }
    }

    PanelWindow {
        visible: root.osdVisible // unmapped when hidden — zero idle cost
        anchors.bottom: true     // bottom-only anchor = horizontally centered
        margins.bottom: 120
        exclusionMode: ExclusionMode.Ignore
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "qs-osd"
        implicitWidth: 280
        implicitHeight: 48
        color: "transparent"

        Rectangle {
            anchors.fill: parent
            radius: 10
            color: root.colBar
            border.width: 2
            border.color: root.colPill

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 16
                anchors.rightMargin: 16
                spacing: 10

                PillText {
                    text: root.volumeMuted ? "󰝟" : root.volumeLevel === 0 ? "󰕿" : root.volumeLevel < 50 ? "󰖀" : "󰕾"
                    color: root.volumeMuted ? root.colDim : root.colCyan
                }
                Rectangle { // thin track + fill
                    Layout.fillWidth: true
                    Layout.alignment: Qt.AlignVCenter
                    implicitHeight: 4
                    radius: 2
                    color: root.colPill

                    Rectangle {
                        width: parent.width * Math.min(root.volumeLevel, 100) / 100
                        height: 4
                        radius: 2
                        color: root.volumeMuted ? root.colDim : root.colCyan
                        // 150ms matches the volRefresh cadence (400ms would lag key-repeat)
                        Behavior on width { NumberAnimation { duration: 150; easing.type: Easing.OutCubic } }
                    }
                }
                PillText {
                    text: root.volumeMuted ? "muted" : root.volumeLevel + "%"
                }
            }
        }
    }

    // ── Notifications (replaces dunst) ───────────────────────────────────
    // keepOnReload false: theme switch rewrites Colors.qml → full config
    // reload — false means old popups can never replay. (If a history UI is
    // ever added: flip to true and gate popups on !modelData.lastGeneration.)
    NotificationServer {
        id: notifServer
        keepOnReload: false
        bodySupported: true
        onNotification: n => n.tracked = true
    }

    PanelWindow {
        visible: notifServer.trackedNotifications.values.length > 0
        anchors {
            top: true
            right: true
        }
        margins {
            top: 12
            right: 12
        }
        exclusiveZone: 0 // reserve nothing, but sit below the bar's zone
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "qs-notifications"
        implicitWidth: 320
        implicitHeight: notifCol.implicitHeight
        color: "transparent"

        Column {
            id: notifCol
            width: 320
            spacing: 8
            add: Transition {
                NumberAnimation { property: "opacity"; from: 0; to: 1; duration: 400; easing.type: Easing.OutCubic }
                NumberAnimation { property: "x"; from: 40; to: 0; duration: 400; easing.type: Easing.OutCubic }
            }
            move: Transition {
                NumberAnimation { property: "y"; duration: 400; easing.type: Easing.OutCubic }
            }

            Repeater {
                model: notifServer.trackedNotifications

                Rectangle {
                    id: card
                    required property Notification modelData
                    required property int index
                    // dunst semantics: explicit 0 = sticky; critical default = sticky
                    property bool sticky: modelData.expireTimeout === 0
                        || (modelData.urgency === NotificationUrgency.Critical && modelData.expireTimeout < 0)

                    visible: index < 5 // dunst notification_limit
                    width: 320
                    implicitHeight: cardText.implicitHeight + 28
                    radius: 10
                    color: root.colBar
                    border.width: 2
                    border.color: modelData.urgency === NotificationUrgency.Critical ? root.colRed
                                : modelData.urgency === NotificationUrgency.Low ? root.colCyan
                                : root.colAccent

                    Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }

                    Column {
                        id: cardText
                        anchors {
                            left: parent.left
                            right: parent.right
                            verticalCenter: parent.verticalCenter
                            margins: 16
                        }
                        spacing: 3

                        Text {
                            width: parent.width
                            text: card.modelData.summary
                            color: root.colFg
                            font { family: root.fontFamily; pixelSize: root.fontSize; bold: true }
                            wrapMode: Text.Wrap
                            maximumLineCount: 2
                            elide: Text.ElideRight
                        }
                        Text {
                            width: parent.width
                            visible: text !== ""
                            text: card.modelData.body
                            textFormat: Text.StyledText // dunst markup=full: <b>/<i>/<u>
                            color: root.colDim
                            font { family: root.fontFamily; pixelSize: root.fontSize - 1 }
                            wrapMode: Text.Wrap
                            maximumLineCount: 6
                            elide: Text.ElideRight
                        }
                    }

                    Timer {
                        // expireTimeout is in SECONDS; >0 honored, -1 = defaults
                        interval: card.modelData.expireTimeout > 0 ? card.modelData.expireTimeout * 1000
                            : card.modelData.urgency === NotificationUrgency.Low ? 5000 : 10000
                        running: card.visible && !card.sticky // overflow (>5) waits its turn
                        onTriggered: card.modelData.expire()
                    }
                    MouseArea {
                        anchors.fill: parent
                        acceptedButtons: Qt.LeftButton | Qt.RightButton
                        onClicked: mouse => {
                            if (mouse.button === Qt.RightButton)
                                notifServer.trackedNotifications.values.slice().forEach(n => n.dismiss())
                            else
                                card.modelData.dismiss()
                        }
                    }
                }
            }
        }
    }

    // ── Network (nmcli polling, 5s) ──────────────────────────────────────
    Process {
        id: netProc
        command: ["sh", "-c",
            "out=$(nmcli -t -f TYPE,STATE device status 2>/dev/null" +
            " | awk -F: '$2 ~ /^connected/ && ($1==\"ethernet\"||$1==\"wifi\"){print $1; exit}');" +
            " echo \"${out:-offline}\""]
        stdout: SplitParser {
            onRead: data => root.netStatus = data.trim()
        }
        Component.onCompleted: running = true
    }

    // ── Timers ───────────────────────────────────────────────────────────
    Timer { // slow poll: volume drift + window title fallback
        interval: 2000
        running: true
        repeat: true
        onTriggered: {
            volProc.running = true
            windowProc.running = true
        }
    }

    Timer { // network
        interval: 5000
        running: true
        repeat: true
        onTriggered: netProc.running = true
    }

    Timer { // clock
        interval: 1000
        running: true
        repeat: true
        onTriggered: root.now = new Date()
    }

    // ── Reusable module pill ─────────────────────────────────────────────
    component Pill: Rectangle {
        id: pill
        property alias hovered: pillMouse.containsMouse
        default property alias content: inner.data
        signal clicked(var mouse)
        signal wheeled(var wheel)

        radius: 7
        color: hovered ? root.colPillHover : root.colPill
        implicitHeight: 26
        implicitWidth: inner.implicitWidth + 22
        Layout.alignment: Qt.AlignVCenter

        // crossfade on theme switch (and a soft hover)
        Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }

        RowLayout {
            id: inner
            anchors.centerIn: parent
            spacing: 7
        }

        MouseArea {
            id: pillMouse
            anchors.fill: parent
            hoverEnabled: true
            acceptedButtons: Qt.LeftButton | Qt.RightButton
            onClicked: mouse => pill.clicked(mouse)
            onWheel: wheel => pill.wheeled(wheel)
        }
    }

    component PillText: Text {
        font.family: root.fontFamily
        font.pixelSize: root.fontSize
        color: root.colFg
        Layout.alignment: Qt.AlignVCenter

        Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }
    }

    // ── Bar ──────────────────────────────────────────────────────────────
    Variants {
        model: Quickshell.screens

        PanelWindow {
            property var modelData
            screen: modelData

            anchors {
                top: true
                left: true
                right: true
            }

            implicitHeight: 36
            color: root.colBar

            RowLayout {
                anchors.fill: parent
                anchors.leftMargin: 12
                anchors.rightMargin: 12
                spacing: 8

                // Workspaces: one pill, active number highlighted
                Rectangle {
                    radius: 7
                    color: root.colPill
                    implicitHeight: 26
                    implicitWidth: wsRow.implicitWidth + 12
                    Layout.alignment: Qt.AlignVCenter

                    Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }

                    Row {
                        id: wsRow
                        anchors.centerIn: parent
                        spacing: 2

                        Repeater {
                            model: 10

                            Rectangle {
                                property var workspace: Hyprland.workspaces.values.find(ws => ws.id === index + 1) ?? null
                                property bool isActive: Hyprland.focusedWorkspace?.id === index + 1
                                property bool occupied: workspace !== null

                                visible: index < 5 || occupied || isActive
                                width: 22
                                height: 20
                                anchors.verticalCenter: parent.verticalCenter
                                radius: 5
                                color: isActive ? root.colAccent : "transparent"

                                Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }

                                Text {
                                    anchors.centerIn: parent
                                    text: index + 1
                                    color: parent.isActive ? root.colBar
                                         : parent.occupied ? root.colFg
                                         : root.colDim
                                    font.family: root.fontFamily
                                    font.pixelSize: root.fontSize - 1
                                    font.bold: parent.isActive

                                    Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    onClicked: Hyprland.dispatch("workspace " + (index + 1))
                                }
                            }
                        }
                    }
                }

                // Focused window title
                Text {
                    visible: root.activeWindow !== ""
                    text: root.activeWindow
                    color: root.colDim
                    font.family: root.fontFamily
                    font.pixelSize: root.fontSize
                    elide: Text.ElideRight
                    maximumLineCount: 1
                    Layout.leftMargin: 6
                    Layout.maximumWidth: 600
                    Layout.alignment: Qt.AlignVCenter

                    Behavior on color { ColorAnimation { duration: 400; easing.type: Easing.OutCubic } }
                }

                Item { Layout.fillWidth: true } // spacer

                // Media (MPRIS): now playing — click = play/pause, scroll = next/prev.
                // Prefers whichever player is actually playing (e.g. Spotify vs
                // a paused mpv); text is truncated in JS so the pill stays compact.
                Pill {
                    id: mediaPill
                    property var player: Mpris.players.values.find(p => p.playbackState === MprisPlaybackState.Playing)
                        ?? Mpris.players.values[0] ?? null
                    property bool playing: player?.playbackState === MprisPlaybackState.Playing

                    visible: player !== null && (player.trackTitle ?? "") !== ""
                    onClicked: if (player?.canTogglePlaying) player.togglePlaying()
                    onWheeled: wheel => {
                        if (!player) return
                        if (wheel.angleDelta.y > 0 && player.canGoNext) player.next()
                        else if (wheel.angleDelta.y < 0 && player.canGoPrevious) player.previous()
                    }

                    PillText {
                        text: mediaPill.playing ? "󰏤" : "󰐊"
                        color: root.colGreen
                    }
                    PillText {
                        text: {
                            var p = mediaPill.player
                            if (!p) return ""
                            var s = (p.trackArtist ? p.trackArtist + " — " : "") + (p.trackTitle ?? "")
                            return s.length > 45 ? s.slice(0, 44) + "…" : s
                        }
                        color: mediaPill.playing ? root.colFg : root.colDim
                    }
                }

                // Volume: click = mute toggle, scroll = +/- 2%
                Pill {
                    onClicked: root.volAction(["set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"])
                    onWheeled: wheel => root.volAction(
                        ["set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@",
                         wheel.angleDelta.y > 0 ? "2%+" : "2%-"])

                    PillText {
                        text: root.volumeMuted ? "󰝟" : root.volumeLevel === 0 ? "󰕿" : root.volumeLevel < 50 ? "󰖀" : "󰕾"
                        color: root.volumeMuted ? root.colDim : root.colCyan
                    }
                    PillText {
                        text: root.volumeMuted ? "muted" : root.volumeLevel + "%"
                        color: root.volumeMuted ? root.colDim : root.colFg
                    }
                }

                // Network
                Pill {
                    PillText {
                        text: root.netStatus === "ethernet" ? "󰈀"
                            : root.netStatus === "wifi" ? "󰖩"
                            : "󰖪"
                        color: root.netStatus === "offline" ? root.colRed : root.colGreen
                    }
                    PillText {
                        text: root.netStatus === "offline" ? "offline" : root.netStatus
                        color: root.netStatus === "offline" ? root.colRed : root.colFg
                    }
                }

                // System tray (only visible when there are items)
                Pill {
                    visible: SystemTray.items.values.length > 0

                    Repeater {
                        model: SystemTray.items

                        Image {
                            source: modelData.icon
                            sourceSize.width: 18
                            sourceSize.height: 18
                            Layout.preferredWidth: 18
                            Layout.preferredHeight: 18
                            Layout.alignment: Qt.AlignVCenter

                            MouseArea {
                                anchors.fill: parent
                                acceptedButtons: Qt.LeftButton | Qt.RightButton
                                onClicked: mouse => {
                                    if (mouse.button === Qt.LeftButton)
                                        modelData.activate()
                                    else
                                        modelData.secondaryActivate()
                                }
                            }
                        }
                    }
                }

                // Clock: click toggles date
                Pill {
                    onClicked: root.clockShowDate = !root.clockShowDate

                    PillText {
                        text: "󰥔"
                        color: root.colPurple
                    }
                    PillText {
                        text: Qt.formatDateTime(root.now,
                            root.clockShowDate ? "ddd dd MMM  HH:mm" : "HH:mm")
                        color: root.colPurple
                        font.bold: true
                    }
                }
            }
        }
    }
}
