# Wofi - Clean config

show=drun
location=top
width=700
lines=8
columns=2
dynamic_lines=false

allow_images=true
image_size=36

matching=fuzzy
insensitive=true
hide_scroll=false
prompt=

term=ghostty

# Vim keybinds
key_up=Ctrl-k
key_down=Ctrl-j
key_left=Ctrl-h
key_right=Ctrl-l
key_submit=Return
key_forward=Tab
key_backward=Shift-ISO_Left_Tab
